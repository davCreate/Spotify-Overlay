{
  "name": "spotify-overlay",
  "productName": "Spotify Overlay",
  "version": "1.0.5",
  "description": "A highly customizable, always-on-top overlay that shows your currently playing Spotify track with album art, real-time progress, audio visualizers and themes.",
  "main": "src/main/main.js",
  "author": "davCreate",
  "license": "MIT",
  "homepage": "https://github.com/davCreate/Spotify-Overlay#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davCreate/Spotify-Overlay.git"
  },
  "bugs": {
    "url": "https://github.com/davCreate/Spotify-Overlay/issues"
  },
  "keywords": [
    "spotify",
    "overlay",
    "now-playing",
    "electron",
    "visualizer",
    "obs",
    "streaming"
  ],
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node --test",
    "lint": "node scripts/check-syntax.js",
    "icon": "node scripts/generate-icon.js",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.davcreate.spotifyoverlay",
    "productName": "Spotify Overlay",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "LICENSE"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Spotify-Overlay-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.music",
      "artifactName": "Spotify-Overlay-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icon.png",
      "category": "AudioVideo",
      "maintainer": "davCreate <https://github.com/davCreate>"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "davCreate",
        "repo": "Spotify-Overlay",
        "releaseType": "release"
      }
    ],
    "portable": {
      "artifactName": "Spotify-Overlay-${version}-portable.${ext}"
    },
    "appImage": {
      "artifactName": "Spotify-Overlay-${version}.${ext}"
    },
    "deb": {
      "artifactName": "spotify-overlay_${version}_${arch}.${ext}"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
